# Copy to .env and fill in real values. .env is git-ignored.
# Consumed by compose.yaml and Spring Boot (via application.properties placeholders).

# MySQL
MYSQL_DATABASE=recipes
MYSQL_USER=recipe
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Spring Datasource (points at the compose service by default)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/recipes
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}

# Hibernate (prod default: do not auto-manage schema)
SPRING_JPA_HIBERNATE_DDL_AUTO=none
